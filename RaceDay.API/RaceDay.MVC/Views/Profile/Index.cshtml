@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "My Profile";

    var firstName = Context.Session.GetString("FirstName");
    var lastName = Context.Session.GetString("LastName");
    var email = Context.Session.GetString("Email");
    var role = Context.Session.GetString("Role");
}

<div class="container mt-5 mb-5">

    <div class="text-center mb-4">
        <h1>My Profile</h1>
        <p class="text-muted">
            View your RaceDay account information.
        </p>
    </div>

    <div class="card shadow mx-auto"
         style="max-width: 650px; border-radius: 15px;">

        <div class="card-body p-4">

            <div class="text-center mb-4">
                <div style="
                    width: 100px;
                    height: 100px;
                    background: #64152f;
                    color: white;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 35px;
                    margin: auto;">
                    @(string.IsNullOrEmpty(firstName)
                        ? "U"
                        : firstName.Substring(0, 1).ToUpper())
                </div>

                <h3 class="mt-3">
                    @firstName @lastName
                </h3>

                <span class="badge bg-dark">@role</span>
            </div>

            <hr />

            <p><strong>First Name:</strong> @firstName</p>
            <p><strong>Last Name:</strong> @lastName</p>
            <p><strong>Email Address:</strong> @email</p>
            <p><strong>Account Type:</strong> @role</p>

            <div class="text-center mt-4">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-dark">
                    Back to Home
                </a>
            </div>

        </div>
    </div>
</div>