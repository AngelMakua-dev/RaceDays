@model RaceDay.MVC.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="mb-4">
                <span style="color:#64152f; font-weight:600; letter-spacing:2px;">
                    RACEDAY ACCOUNT
                </span>
                <h1 class="fw-bold mt-2">Edit Your Profile</h1>
                <p class="text-muted">
                    Keep your personal information up to date.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <form asp-controller="Profile"
                          asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName"
                                       class="form-label fw-semibold">
                                    First Name
                                </label>
                                <input asp-for="FirstName"
                                       class="form-control" />
                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName"
                                       class="form-label fw-semibold">
                                    Last Name
                                </label>
                                <input asp-for="LastName"
                                       class="form-control" />
                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email Address
                            </label>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control" />
                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        @if (Model.Role == "Participant")
                        {
                            <hr class="my-4" />

                            <h5 class="fw-bold mb-3">
                                Participant Information
                            </h5>

                            <div class="mb-3">
                                <label asp-for="DateOfBirth"
                                       class="form-label fw-semibold">
                                    Date of Birth
                                </label>
                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control" />
                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="EmergencyContactName"
                                       class="form-label fw-semibold">
                                    Emergency Contact Name
                                </label>
                                <input asp-for="EmergencyContactName"
                                       class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label asp-for="EmergencyContactPhone"
                                       class="form-label fw-semibold">
                                    Emergency Contact Phone
                                </label>
                                <input asp-for="EmergencyContactPhone"
                                       class="form-control" />
                            </div>
                        }

                        @if (Model.Role == "Organiser")
                        {
                            <hr class="my-4" />

                            <h5 class="fw-bold mb-3">
                                Organisation Information
                            </h5>

                            <div class="mb-3">
                                <label asp-for="OrganisationName"
                                       class="form-label fw-semibold">
                                    Organisation Name
                                </label>
                                <input asp-for="OrganisationName"
                                       class="form-control" />
                            </div>
                        }

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit"
                                    class="btn text-white px-4"
                                    style="background:#64152f;">
                                Save Changes
                            </button>

                            <a asp-controller="Profile"
                               asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}