@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Organiser Dashboard";

    var firstName = Context.Session.GetString("FirstName");
}

<style>
    .organiser-hero {
        background: linear-gradient(120deg, #430d20, #741b3b);
        color: white;
        padding: 45px;
        border-radius: 14px;
        margin: 25px 0 35px;
    }

    .organiser-hero h1 {
        color: white;
        font-family: 'Playfair Display', serif;
        font-size: 40px;
        font-weight: 800;
    }

    .organiser-label {
        color: #d6b879;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    .organiser-card {
        background: white;
        padding: 28px;
        border-radius: 12px;
        height: 100%;
        border-bottom: 4px solid #64152f;
        box-shadow: 0 5px 25px rgba(0,0,0,0.05);
    }

    .organiser-card h4 {
        font-family: 'Inter', sans-serif;
        font-weight: 700;
        margin: 15px 0;
    }

    .organiser-card p {
        color: #777177;
        line-height: 1.7;
        font-size: 14px;
    }

    .organiser-icon {
        font-size: 30px;
        color: #64152f;
    }

    .organiser-section-heading {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        margin-bottom: 25px;
    }

    .dashboard-notice {
        background: #f5e8ed;
        color: #64152f;
        padding: 20px;
        border-radius: 8px;
        margin-top: 30px;
        font-size: 14px;
    }
</style>

<div class="organiser-hero">

    <div class="organiser-label">
        RaceDay Management
    </div>

    <h1 class="mt-3">
        Welcome, @firstName.
    </h1>

    <p class="mt-3 mb-0">
        Manage your sporting events and oversee
        your RaceDay activities from one place.
    </p>

</div>

<h2 class="organiser-section-heading">
    Your Management Workspace
</h2>

<div class="row g-4">

    <div class="col-md-4">
        <div class="organiser-card">

            <div class="organiser-icon">🏆</div>

            <h4>Event Management</h4>

            <p>
                Create and manage sporting events,
                including event details, dates,
                locations and banners.
            </p>

            <span class="badge bg-light text-dark">
                Event features pending connection
            </span>

        </div>
    </div>

    <div class="col-md-4">
        <div class="organiser-card">

            <div class="organiser-icon">👥</div>

            <h4>Participant Management</h4>

            <p>
                Oversee participant enrolments,
                categories and registration
                information for your events.
            </p>

            <span class="badge bg-light text-dark">
                Enrolment features pending connection
            </span>

        </div>
    </div>

    <div class="col-md-4">
        <div class="organiser-card">

            <div class="organiser-icon">🥇</div>

            <h4>Results Management</h4>

            <p>
                Record race finishing times,
                positions and publish sporting
                results.
            </p>

            <span class="badge bg-light text-dark">
                Results features pending connection
            </span>

        </div>
    </div>

</div>

<div class="dashboard-notice">

    <strong>Dashboard information:</strong>

    Your management workspace is ready.
    Event statistics and participant information
    will appear here once the API functionality
    is connected.

</div>

<div class="mt-4 mb-4">

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-raceday">
        Back to Home
    </a>

</div>
